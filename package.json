{
  "name": "restaurante-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --proxy-config proxy.conf.json",
    "port:free": "lsof -ti:4200 | xargs kill -9 2>/dev/null || echo 'Puerto 4200 ya está libre'",
    "mobile:clean": "bash scripts/clean-mobile.sh",
    "mobile:live": "npm run ios:dev & sleep 8 && (node tools/android-live.mjs --ip localhost --port 4200 --reverse 8080 --target R5CY30CJF7X & export LANG=en_US.UTF-8 && npx cap run ios --target=\"B44114B9-8BAC-4F5C-A9A2-8C8CE1CC105D\")",
    "firebase:setup": "bash scripts/setup-firebase-credentials.sh",
    "android:dev": "npm run start -- --host 0.0.0.0 --port 4200",
    "android:dev:adb": "adb reverse tcp:4200 tcp:4200 && npm run android:dev",
    "android:cap:live": "npx cap run android -l --external",
    "android:live:auto": "node tools/android-live.mjs",
    "android:live:reverse": "node tools/android-live.mjs --ip localhost --port 4200 --reverse 8080",
    "android:live:wifi": "npm run android:live:auto -- --target adb-R5CY30CJF7X-SZKcHs._adb-tls-connect._tcp --ip 192.168.1.2 --port 4200 --reverse 8080",
    "android:live:wifi:2:2": "npm run android:live:auto -- --target 192.168.1.155:42763 --ip 192.168.1.2 --port 4200 --reverse 8080",
    "android:live:usb": "npm run android:live:reverse -- --target R5CY30CJF7X",
    "ios:dev": "npm run start -- --host 0.0.0.0 --port 4200",
    "ios:cap:live": "npx cap run ios -l --external",
    "ios:live": "npm run ios:dev",
    "ios:live:iphone": "npm run ios:dev & sleep 8 && export LANG=en_US.UTF-8 && npx cap run ios --target=\"B44114B9-8BAC-4F5C-A9A2-8C8CE1CC105D\"",
    "ios:live:ipad": "npm run ios:dev & sleep 8 && export LANG=en_US.UTF-8 && npx cap run ios --target=\"582C4163-4065-46A8-B765-FCFEE9164CBC\"",
    "mobile:live:ipad": "npm run ios:dev & sleep 8 && (node tools/android-live.mjs --ip localhost --port 4200 --reverse 8080 --target R5CY30CJF7X & export LANG=en_US.UTF-8 && npx cap run ios --target=\"582C4163-4065-46A8-B765-FCFEE9164CBC\")",
    "android:install": "adb shell am start -n fogon.maria.app/fogon.maria.app.MainActivity",
    "test:web-push": "npm run build:webview && node -e \"require('fs').copyFileSync('dist/restaurante-frontend/browser/index.csr.html', 'dist/restaurante-frontend/browser/index.html')\" && npx serve dist/restaurante-frontend/browser -l 4201 --single",
    "android:uninstall": "adb shell pm uninstall fogon.maria.app",
    "android:open": "adb shell am start -n fogon.maria.app/fogon.maria.app.MainActivity",
    "start:prod:local": "npx serve dist/restaurante-frontend/browser",
    "serve:ssr:restaurante-frontend": "node dist/restaurante-frontend/server/server.mjs",
    "build": "ng build",
    "build:ssr": "ng build --configuration=production-ssr",
    "build:webview": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.{ts,js,html}",
    "format": "prettier \"src/**/*.{ts,html,scss,md}\" --write",
    "format:check": "prettier \"src/**/*.{ts,html,scss,md}\" --check",
    "images:generate": "node tools/generate-images.mjs",
    "images:png2webp": "node tools/png-to-webp.mjs",
    "postbuild": "node tools/generate-sitemap.mjs",
    "limpieza": "npx rimraf node_modules package-lock.json .angular/cache && npm install --prefer-online",
    "deps:unused": "npx depcheck",
    "updates": "npm-check-updates -u && npm install",
    "lint:scss": "stylelint src/**/*.scss --fix",
    "validate:mocks": "node tools/validate-mocks.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "lint:fix:imports": "eslint \"src/**/*.{ts,js}\" --fix --rule \"simple-import-sort/imports:error\" --rule \"simple-import-sort/exports:error\"",
    "security:audit": "node tools/security-audit.mjs",
    "smoke:test": "node tools/smoke-tests.mjs",
    "cap:init": "npx cap init \"El Fogón de María\" fogon.maria.app --web-dir dist/restaurante-frontend/browser",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:doctor": "npx cap doctor",
    "cap:assets:android": "npx capacitor-assets generate --android --iconBackgroundColor \"#d4a017\"",
    "cap:assets:ios": "npx capacitor-assets generate --ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@angular/ssr": "^21.2.24",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "browser-image-compression": "^2.0.2",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jwt-decode": "^4.0.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "16.2.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "stylelint": "^17.16.0",
    "ts-jest": "29.4.14"
  }
}
